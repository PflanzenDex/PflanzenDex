{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "pflanzendex": {
      "source": { "source": "github", "repo": "PflanzenDex/PflanzenDex", "ref": "dev" }
    }
  },
  "enabledPlugins": { "status-panel@pflanzendex": true },
  "permissions": {
    "allow": [
      "Bash(make)",
      "Bash(make *)",
      "Bash(git fetch *)",
      "Bash(git ls-tree *)",
      "Bash(git push origin HEAD)",
      "Bash(git push -q origin HEAD)",
      "Bash(npm view *)",
      "Bash(npm ls *)",
      "Bash(npm audit)",
      "Bash(gh project field-list *)",
      "Bash(gh project item-list *)",
      "Bash(gh project view *)",
      "Bash(docker rm -f -v pflanzendex-test-db-*)"
    ],
    "deny": [
      "Bash(sed -n -i:*)",
      "Bash(rg --pre:*)",
      "Bash(gh pr merge:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.worktree)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.mjs\" guard-edit",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.mjs\" guard-bash",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.mjs\" guard-read",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.mjs\" after-edit",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.mjs\" after-bash",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "implementer",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.mjs\" subagent-stop",
            "timeout": 900
          }
        ]
      },
      {
        "matcher": "implementer|ticket-lead",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.mjs\" subagent-push",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.mjs\" stop",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
