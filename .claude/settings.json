{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make gates)",
      "Bash(make ci)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make typecheck)",
      "Bash(make format)",
      "Bash(make secrets)",
      "Bash(make workflows)",
      "Bash(make release-dry-run)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current)",
      "Bash(gh pr view:*)",
      "Bash(make merge:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(git fetch origin)",
      "Bash(git fetch -q origin)",
      "Bash(make ci-wait PR=*)",
      "Bash(make board)",
      "Bash(make status-check)",
      "Bash(make layout)",
      "Bash(make docs-check)",
      "Bash(make reference-check)",
      "Bash(make setup)",
      "Bash(make db-up)",
      "Bash(make migrate)",
      "Bash(make worktree BRANCH=*)",
      "Bash(docker rm -f -v pflanzendex-test-db-*)",
      "Bash(make claim ISSUE=*)",
      "Bash(make pr PR=*)",
      "Bash(git push origin HEAD)",
      "Bash(git push -q origin HEAD)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(sed -n:*)",
      "Bash(make pr-state PR=*)",
      "Bash(make issue-read ISSUE=*)",
      "Bash(make pr-text PR=*)",
      "Bash(make issue-comment ISSUE=*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.mjs\" guard-edit", "timeout": 10 }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.mjs\" guard-bash", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.mjs\" after-edit", "timeout": 30 }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.mjs\" after-bash", "timeout": 15 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/run.mjs\" stop", "timeout": 15 }]
      }
    ]
  }
}
