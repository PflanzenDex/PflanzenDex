# Template. Copy to deploy/.env (ignored by git); real values never go into the repo (QG-S1).
POSTGRES_USER=pflanzendex
POSTGRES_PASSWORD=PUT_A_LONG_RANDOM_PASSWORD_HERE
POSTGRES_DB=pflanzendex
# Public address for HTTPS (domain still open). Locally: localhost (internal CA; the port comes from HTTPS_PORT)
SITE_ADDRESS=localhost
HTTP_PORT=8080
HTTPS_PORT=8443
# Backup: target folder, retention in days, optional second target (rsync, e.g. user@host:/path; still open)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_REMOTE=
