# Vorlage. Kopie nach deploy/.env (von .gitignore ausgeschlossen); echte Werte nie ins Repo (QG-S1).
POSTGRES_USER=pflanzendex
POSTGRES_PASSWORD=HIER_EIN_LANGES_ZUFAELLIGES_PASSWORT
POSTGRES_DB=pflanzendex
# Öffentliche Adresse für HTTPS (Domain, noch offen). Lokal: localhost (interne CA; der Port kommt aus HTTPS_PORT)
SITE_ADDRESS=localhost
HTTP_PORT=8080
HTTPS_PORT=8443
# Sicherung: Zielordner, Aufbewahrung in Tagen, optionales zweites Ziel (rsync, z. B. nutzer@host:/pfad; noch offen)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_REMOTE=
