{
  "name": "pflanzendex",
  "private": true,
  "type": "module",
  "description": "PflanzenDex: web app for plant collectors (monorepo: core, db, api, web)",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node tools/workflow/worktree/dev-servers.mjs",
    "lint": "eslint . --cache --cache-strategy content --cache-location \"$(node tools/check/quality/gates/eslint-shared.mjs --cache-file lint)\"",
    "format": "prettier --write . \"../tools/**/*.{ts,tsx,js,mjs,json,css,html,yml,yaml}\" \"../.claude/**/*.{ts,tsx,js,mjs,json,css,html,yml,yaml}\" \"!../.claude/settings.local.json\" --config .prettierrc.json",
    "format:check": "prettier --check . \"../tools/**/*.{ts,tsx,js,mjs,json,css,html,yml,yaml}\" \"../.claude/**/*.{ts,tsx,js,mjs,json,css,html,yml,yaml}\" \"!../.claude/settings.local.json\" --config .prettierrc.json --cache --cache-strategy content --cache-location .cache/gates/prettier",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "boundaries": "node tools/check/code/check-boundaries.mjs",
    "layout": "node tools/check/code/layout/check-layout.mjs",
    "migration-numbers": "node tools/workflow/claim/migration/check-migration-numbers.mjs",
    "db-indexes": "node tools/check/code/db-indexes/check-db-indexes.mjs",
    "layout-fix": "node tools/layout-fix/layout-fix.mjs",
    "ci-drift": "node tools/check/release/check-ci-drift.mjs",
    "baseline": "node tools/check/quality/gates/check-baseline.mjs",
    "design-system": "node tools/check/code/design-system/check-design-system.mjs",
    "ui-text": "node tools/check/code/ui-text/check-ui-text.mjs",
    "constants": "node tools/check/code/constants/check-constants.mjs",
    "stories": "node tools/check/quality/check-stories.mjs",
    "bundle-budget": "node tools/check/supply/check-bundle-budget.mjs",
    "bundle-report": "node tools/check/supply/report-bundle.mjs",
    "conformance": "node tools/check/code/conformance/check-conformance.mjs --report && node --test tools/check/code/conformance/check-conformance.selftest.mjs",
    "conformance:blocking": "node tools/check/code/conformance/check-conformance.mjs && node --test tools/check/code/conformance/check-conformance.selftest.mjs",
    "ds-snapshots": "node tools/check/code/conformance/ds-snapshots.mjs && node --test tools/check/code/conformance/ds-snapshots.selftest.mjs",
    "ds-snapshots:update": "node tools/check/code/conformance/ds-snapshots.mjs --update",
    "health": "node tools/dev/health-summary.mjs",
    "docs": "cd .. && npx markdownlint-cli2 \"docs/**/*.md\" \"CLAUDE.md\" --config \".markdownlint-cli2.jsonc\" && cd app && node tools/check/docs/check-links.mjs",
    "specs": "node tools/check/docs/specs/check-specs.mjs && node tools/check/docs/specs/check-traceability.mjs && node tools/check/docs/specs/check-spec-refs.mjs && node tools/dev/agent/spec-status.mjs --check",
    "spec-numbers": "node --import tsx tools/check/docs/specs/spec-numbers/check-spec-numbers.mjs",
    "dod-numbers": "node tools/check/docs/specs/spec-numbers/check-dod-numbers.mjs",
    "principles": "node tools/check/docs/check-principles.mjs",
    "principles-review": "node tools/check/docs/check-principles-review.mjs",
    "test": "npm run test --workspaces --if-present && npm run test:tools",
    "test:tools": "node --test \"tools/**/*.test.mjs\" \"../.claude/hooks/*.test.mjs\" \"../tools/lighthouse/*.test.mjs\" \"../tools/measure/*.test.mjs\" \"../tools/repo/*.test.mjs\" \"../tools/release/*.test.mjs\"",
    "coverage": "npm run test --workspaces --if-present -- --coverage && npm run test:tools && node tools/check/quality/coverage/check-coverage-ratchet.mjs",
    "build": "npm run build --workspaces --if-present",
    "gates": "node tools/check/quality/gates/run-gates.mjs",
    "crap": "node tools/check/quality/check-crap.mjs",
    "ci": "node tools/dev/agent/ci-parts.mjs",
    "ci:gates": "npm run gates",
    "ci:docs": "npm run docs && npm run specs && npm run spec-numbers && npm run dod-numbers && npm run principles && npm run skills && npm run reference",
    "ci:tests": "npm run ci:tests:base && npm run ci:tests:web && npm run ci:coverage",
    "ci:tests:base": "npm run ci:tests:workspaces && npm run ci:tests:tools",
    "ci:tests:workspaces": "npm run test -w @pflanzendex/api -w @pflanzendex/core -w @pflanzendex/db -- --coverage",
    "ci:tests:tools": "npm run test:tools",
    "ci:tests:web": "npm run test -w @pflanzendex/web -- --coverage",
    "ci:coverage": "node tools/check/quality/coverage/check-coverage-ratchet.mjs && npm run crap",
    "ci:ui": "npm run build && npm run bundle-budget && npm run conformance:blocking",
    "knip": "knip -c config/lint/knip.json",
    "unused-report": "mkdir -p .cache && knip -c config/lint/knip.json --production --no-exit-code --no-config-hints --reporter markdown > .cache/unused-report.md && cat .cache/unused-report.md",
    "audit": "node tools/check/supply/check-audit.mjs",
    "skills": "node tools/check/docs/agents/check-skills.mjs",
    "reference": "node tools/check/docs/agents/check-reference.mjs",
    "dup": "node tools/check/quality/duplicates/check-dup.mjs",
    "duplicates": "node tools/check/quality/duplicates/check-duplicates.mjs",
    "release-tags": "node tools/check/release/check-release-tags.mjs",
    "e2e": "npm run e2e -w @pflanzendex/e2e",
    "one-screen": "npm run one-screen -w @pflanzendex/e2e",
    "one-screen:write": "npm run one-screen:write -w @pflanzendex/e2e",
    "a11y-routes": "npm run a11y-routes -w @pflanzendex/e2e",
    "a11y-routes:write": "npm run a11y-routes:write -w @pflanzendex/e2e",
    "a11y-routes:baseline": "npm run a11y-routes:baseline -w @pflanzendex/e2e --",
    "changelog": "node tools/check/release/check-changelog.mjs",
    "storybook": "npm run storybook -w @pflanzendex/web",
    "build-storybook": "npm run build-storybook -w @pflanzendex/web"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/lint": "21.2.4",
    "@commitlint/load": "21.2.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "concurrently": "10.0.6",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "10.13.0",
    "eslint-plugin-security": "4.2.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "fallow": "3.36.0",
    "globals": "17.13.0",
    "jscpd": "5.4.2",
    "knip": "6.43.0",
    "lint-staged": "17.6.0",
    "markdownlint-cli2": "0.24.0",
    "minimatch": "10.2.6",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "semantic-release": "25.0.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "release": {
    "extends": "./config/project/release.config.js"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write",
      "eslint --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,md,css,html,yml,yaml}": "prettier --write",
    "../{tools,.claude}/**/*.{ts,tsx,js,mjs,json,css,html,yml,yaml}": "prettier --write --config .prettierrc.json"
  }
}
