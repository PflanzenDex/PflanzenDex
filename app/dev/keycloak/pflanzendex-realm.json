{
  "realm": "pflanzendex",
  "enabled": true,
  "displayName": "PflanzenDex",
  "loginTheme": "pflanzendex",
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "editUsernameAllowed": false,
  "internationalizationEnabled": true,
  "supportedLocales": ["de", "en"],
  "defaultLocale": "de",
  "passwordPolicy": "length(10)",
  "bruteForceProtected": true,
  "failureFactor": 5,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 7776000,
  "ssoSessionIdleTimeoutRememberMe": 2592000,
  "ssoSessionMaxLifespanRememberMe": 7776000,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@pflanzendex.localhost",
    "fromDisplayName": "PflanzenDex"
  },
  "clients": [
    {
      "clientId": "pflanzendex-api",
      "name": "PflanzenDex API",
      "enabled": true,
      "bearerOnly": true
    },
    {
      "clientId": "pflanzendex-web",
      "name": "PflanzenDex Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "rootUrl": "http://localhost:5173",
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "pflanzendex-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
