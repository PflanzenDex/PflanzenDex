{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "commitlint": { "config": ["config/project/commitlint.config.js"] },
  "semantic-release": { "config": ["config/project/release.config.js"] },
  "ignoreDependencies": [
    "@commitlint/cli",
    "lint-staged",
    "conventional-changelog-conventionalcommits"
  ],
  "workspaces": {
    ".": {
      "entry": ["tools/**/*.mjs!", "config/lint/modules.config.mjs!"],
      "ignore": [
        "tools/check/quality/coverage/coverage-config.d.mts",
        "config/lint/modules.config.d.mts"
      ]
    },
    "packages/db": {
      "project": ["src/**/*.ts!", "!src/**/fixtures.ts!", "!src/kernel/migrate-cli.ts!"]
    },
    "packages/core": {
      "project": ["src/**/*.ts!", "!src/**/*-test-helpers.ts!", "!src/**/*-stub.ts!"]
    },
    "packages/web": {
      "project": ["src/**/*.{ts,tsx,css}!", "!src/**/*-test-helpers.ts!"],
      "ignore": [".storybook/conformance-fixtures/**"]
    },
    "packages/e2e": {
      "project": ["**/*.ts"]
    }
  }
}
