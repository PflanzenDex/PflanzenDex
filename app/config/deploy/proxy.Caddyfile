# Public entry for two hostnames: the app (web, /api, /health) and the sign-in service (Keycloak).
# All values come from the environment (.env):
#   CADDY_SCHEME     "http://" when TLS ends at a proxy in front of this host (plain HTTP on port 80, no certificates here);
#                    empty when this host faces the internet (Caddy then gets certificates from Let's Encrypt;
#                    locally with localhost names it uses its internal CA).
#   APP_HOST, AUTH_HOST   bare hostnames without scheme.
#   TRUSTED_PROXIES  addresses of the proxy in front; only from there X-Forwarded-* is believed (the sign-in service
#                    builds its public links from them). Anything else gets its forwarded headers overwritten.
{
	servers {
		trusted_proxies static {$TRUSTED_PROXIES}
	}
}

(compress) {
	# Text compression (NFR-12): Caddy negotiates zstd or gzip from Accept-Encoding; it skips images and other
	# already-compressed types. Brotli would need a Caddy plugin, so it is not used (zstd compresses as well).
	encode zstd gzip
}

{$CADDY_SCHEME}{$APP_HOST} {
	import compress
	# Security headers of the app (the SPA holds the sign-in tokens). The build has no inline scripts, so scripts
	# come from this origin only; React sets styles through the DOM and some libraries inject <style>, hence
	# 'unsafe-inline' for styles only. The app talks to its own /api and to the sign-in host (AUTH_URL). No
	# includeSubDomains in HSTS: the parent domain may be shared (e.g. a Tailscale tailnet).
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(self), geolocation=(), microphone=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' {$AUTH_URL}; frame-src {$AUTH_URL}; worker-src 'self'; manifest-src 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
		-Server
		-Via
		defer
	}
	# The API serves its routes without a prefix: /api/x is forwarded as /x. /health stays at the top and answers only
	# the status; the details (version, commit, queue counts) stay inside the stack for the deploy's smoke test (#759).
	handle /health {
		reverse_proxy api:3000
	}
	handle /health/* {
		respond 404
	}
	# The protected resource metadata of the AI interface (RFC 9728, E-04): clients that do not follow the address in the
	# 401 challenge (/api/.well-known/...) look for it at the root, also path-inserted (/.well-known/...resource/api/mcp).
	# The API serves both paths as they are; without this the SPA would answer with its index page.
	handle /.well-known/oauth-protected-resource* {
		reverse_proxy api:3000
	}
	handle_path /api/* {
		handle /health/* {
			respond 404
		}
		handle {
			reverse_proxy api:3000
		}
	}
	handle {
		reverse_proxy web:8080
	}
}

{$CADDY_SCHEME}{$AUTH_HOST} {
	import compress
	# Keycloak's management and master-realm surface is never served on the public name (the host may face the
	# internet, e.g. through Tailscale Funnel). Operator work goes around the proxy: `docker compose exec keycloak
	# kcadm.sh` or an SSH port forward to the container. Login pages need /realms/pflanzendex/*, /resources/*, /js/*.
	handle /admin* {
		respond 404
	}
	# Keycloak redirects its root to the admin console (KC_HOSTNAME_ADMIN, a loopback address): send visitors to the
	# app instead, so the root neither leaks the admin address nor ends in a broken redirect.
	handle / {
		redir {$APP_URL} 302
	}
	handle /realms/master* {
		respond 404
	}
	handle /metrics* {
		respond 404
	}
	handle /health* {
		respond 404
	}
	# Files in /etc/caddy/conf.d/ add routes of the test environment (the mail catcher UI); none in production.
	import /etc/caddy/conf.d/*
	handle {
		reverse_proxy keycloak:8080
	}
}
