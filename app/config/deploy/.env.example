# Template. Copy to config/deploy/.env (ignored by git); real values never go into the repo (QG-S1).
# Generate every secret with e.g. `openssl rand -hex 24` (hex only: the scripts source this file, so no spaces or quotes).

# --- Database -------------------------------------------------------------------------------------------------
POSTGRES_USER=pflanzendex
POSTGRES_PASSWORD=PUT_A_LONG_RANDOM_PASSWORD_HERE
POSTGRES_DB=pflanzendex
# POSTGRES_USER is the cluster superuser: administration only (backup, restore, the `db-roles` and `keycloak-db` one-shots).
# The api and the migrations connect as the schema owner below: a plain role, never a superuser (#907, P-04).
#DB_OWNER_USER=pflanzendex_owner
DB_OWNER_PASSWORD=PUT_A_LONG_RANDOM_PASSWORD_HERE

# --- Public addresses -----------------------------------------------------------------------------------------
# What users type in the browser (scheme + host, no trailing slash) and the bare hostnames behind them.
APP_URL=https://app.example.test
AUTH_URL=https://auth.example.test
APP_HOST=app.example.test
AUTH_HOST=auth.example.test
# TLS ends at a proxy in front of this host (it forwards plain HTTP to port 80): CADDY_SCHEME=http://
# This host faces the internet itself (Caddy gets certificates): leave CADDY_SCHEME empty.
# Locally: APP_URL=https://localhost:8443, AUTH_URL=https://auth.localhost:8443, APP_HOST=localhost, AUTH_HOST=auth.localhost
CADDY_SCHEME=http://
# Address(es) of the proxy in front (space separated CIDRs). Only from there X-Forwarded-* is believed.
TRUSTED_PROXIES=192.0.2.10/32
# Ports published on the host.
HTTP_PORT=80
HTTPS_PORT=443

# --- Sign-in service (Keycloak) ---------------------------------------------------------------------------------
# Its own role and database in the same PostgreSQL server (created by the one-shot `keycloak-db`).
KEYCLOAK_DB_PASSWORD=PUT_A_LONG_RANDOM_PASSWORD_HERE
#KEYCLOAK_DB_NAME=keycloak
#KEYCLOAK_DB_USER=keycloak
# First administrator of the master realm (used at the first start only; change the password in the console afterwards).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=PUT_A_LONG_RANDOM_PASSWORD_HERE
# JVM heap (starting values for a 3 GB host, assumption). Quote the value: it contains a space.
#KEYCLOAK_JAVA_HEAP="-Xms128m -Xmx512m"
# Admin console: only on the host's loopback, reached through an SSH tunnel (runbook "Admin console over an SSH tunnel").
#KEYCLOAK_ADMIN_PORT=8180

# --- Mail (confirmation emails of the sign-in service) ---------------------------------------------------------------
# Test environment: leave all unset (mail catcher `mailpit`, see docker-compose.test.yml).
# Production: a real SMTP server; without SMTP_HOST the sign-in service cannot send the confirmation email.
#SMTP_HOST=smtp.example.test
#SMTP_PORT=587
#SMTP_FROM=noreply@example.test
#SMTP_AUTH=true
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_STARTTLS=true
#SMTP_SSL=false

# --- Mail catcher UI (test environment only) -----------------------------------------------------------------------------
# /mail/ on the sign-in host is behind HTTP basic auth. Required when docker-compose.test.yml is loaded.
# Hash: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'the-password'  (prints a bcrypt hash)
# Keep the single quotes: the hash contains `$`, which the scripts (shell) and Compose would otherwise expand.
MAIL_UI_USER=tester
MAIL_UI_HASH='PUT_A_BCRYPT_HASH_HERE'

# --- Public test environment through Tailscale Funnel (docker-compose.funnel.yml) -------------------------------
# Needs no reverse proxy and no inbound port. With Funnel: APP_URL=https://<TS_APP_NAME>.<tailnet>.ts.net,
# AUTH_URL=https://<TS_AUTH_NAME>.<tailnet>.ts.net, APP_HOST/AUTH_HOST the same names without scheme,
# CADDY_SCHEME=http:// and TRUSTED_PROXIES=172.29.40.2/32 172.29.40.3/32 (the two Tailscale nodes, fixed addresses).
# Auth key (admin console, Settings, Keys): pre-approved, NOT ephemeral, with the tag below, short expiry (1 day).
# Only for the first start: once both nodes are registered, delete this line (the state volumes keep the identity)
# and revoke the key. Whoever holds a valid key can register more nodes with Funnel rights in your tailnet.
TS_AUTHKEY=PUT_A_TAILSCALE_AUTH_KEY_HERE
# Machine names = the first label of the public names. Choose unique, hard to guess names (they are public).
TS_APP_NAME=pflanzendex-app
TS_AUTH_NAME=pflanzendex-auth
#TS_TAG=tag:pflanzendex-funnel

# --- Compose files ----------------------------------------------------------------------------------------------
# Test environment (adds the mail catcher): docker-compose.yml:docker-compose.test.yml. Production: leave unset.
# Public through Tailscale Funnel: append :docker-compose.funnel.yml.
#COMPOSE_FILE=docker-compose.yml:docker-compose.test.yml
#COMPOSE_FILE=docker-compose.yml:docker-compose.test.yml:docker-compose.funnel.yml

# --- Backup -----------------------------------------------------------------------------------------------------
# Target folder (outside the repository: the dumps hold password hashes and realm keys; the script makes it 0700 and
# the files 0600), retention in days, optional second target (rsync, e.g. user@host:/path; still open)
BACKUP_DIR=${HOME}/pflanzendex-backups
BACKUP_RETENTION_DAYS=14
BACKUP_REMOTE=

# --- Catalog jobs (#991, docs/guides/operations/release-and-rollback.md, "Filling the catalog") ----------------------
# Order on a fresh installation: migrate, `npm run catalog:load`, CATALOG_FILL=on, then ATTRIBUTE_FILL=on.
# Both fills stay off while empty. TAXONOMY_BUILD=off stops the hourly taxonomy check (default: on).
CATALOG_FILL=
ATTRIBUTE_FILL=
TAXONOMY_BUILD=

# --- Feature switches (US-DEV-06, docs/guides/operations/release-and-rollback.md) ---------------------------------
# Global switches, comma separated, e.g. FEATURES=social,ai. Empty: all off in production. Needs a restart of the api.
FEATURES=
