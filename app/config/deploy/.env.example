# Template. Copy to config/deploy/.env (ignored by git); real values never go into the repo (QG-S1).
# Generate every secret with e.g. `openssl rand -hex 24` (hex only: the scripts source this file, so no spaces or quotes).

# --- Database -------------------------------------------------------------------------------------------------
POSTGRES_USER=pflanzendex
POSTGRES_PASSWORD=PUT_A_LONG_RANDOM_PASSWORD_HERE
POSTGRES_DB=pflanzendex

# --- Public addresses -----------------------------------------------------------------------------------------
# What users type in the browser (scheme + host, no trailing slash) and the bare hostnames behind them.
APP_URL=https://app.example.test
AUTH_URL=https://auth.example.test
APP_HOST=app.example.test
AUTH_HOST=auth.example.test
# TLS ends at a proxy in front of this host (it forwards plain HTTP to port 80): CADDY_SCHEME=http://
# This host faces the internet itself (Caddy gets certificates): leave CADDY_SCHEME empty.
# Locally: APP_URL=https://localhost:8443, AUTH_URL=https://auth.localhost:8443, APP_HOST=localhost, AUTH_HOST=auth.localhost
CADDY_SCHEME=http://
# Address(es) of the proxy in front (space separated CIDRs). Only from there X-Forwarded-* is believed.
TRUSTED_PROXIES=192.0.2.10/32
# Ports published on the host.
HTTP_PORT=80
HTTPS_PORT=443

# --- Sign-in service (Keycloak) ---------------------------------------------------------------------------------
# Its own role and database in the same PostgreSQL server (created by the one-shot `keycloak-db`).
KEYCLOAK_DB_PASSWORD=PUT_A_LONG_RANDOM_PASSWORD_HERE
#KEYCLOAK_DB_NAME=keycloak
#KEYCLOAK_DB_USER=keycloak
# First administrator of the master realm (used at the first start only; change the password in the console afterwards).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=PUT_A_LONG_RANDOM_PASSWORD_HERE
# JVM heap (starting values for a 3 GB host, assumption). Quote the value: it contains a space.
#KEYCLOAK_JAVA_HEAP="-Xms128m -Xmx512m"

# --- Mail (confirmation emails of the sign-in service) ---------------------------------------------------------------
# Test environment: leave all unset (mail catcher `mailpit`, see docker-compose.test.yml).
# Production: a real SMTP server; without SMTP_HOST the sign-in service cannot send the confirmation email.
#SMTP_HOST=smtp.example.test
#SMTP_PORT=587
#SMTP_FROM=noreply@example.test
#SMTP_AUTH=true
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_STARTTLS=true
#SMTP_SSL=false

# --- Compose files ----------------------------------------------------------------------------------------------
# Test environment (adds the mail catcher): docker-compose.yml:docker-compose.test.yml. Production: leave unset.
#COMPOSE_FILE=docker-compose.yml:docker-compose.test.yml

# --- Backup -----------------------------------------------------------------------------------------------------
# Target folder, retention in days, optional second target (rsync, e.g. user@host:/path; still open)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_REMOTE=
