{
  "name": "@pflanzendex/api",
  "private": true,
  "type": "module",
  "description": "HTTP API: calls core only through its public interface",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "perf:measure": "tsx perf/load/measure.ts",
    "perf:concurrency": "tsx perf/load/concurrency.ts",
    "catalog:check-data": "tsx src/catalog/load/research/run-check.ts",
    "catalog:load": "tsx src/catalog/load/run.ts",
    "taxonomy:build": "tsx src/pokedex/run-taxonomy-build.ts",
    "seed:catalog": "tsx perf/catalog-seed/run-seed.ts",
    "seed:demo": "tsx perf/demo-seed/run-demo-seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@hono/node-server": "2.1.5",
    "@pflanzendex/core": "*",
    "@pflanzendex/db": "*",
    "hono": "4.13.14",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/web-push": "3.6.4",
    "tsx": "4.23.15"
  }
}
