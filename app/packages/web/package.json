{
  "name": "@pflanzendex/web",
  "private": true,
  "type": "module",
  "description": "Mobile-first PWA (React, Vite); imports core only through its public interface",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "icons": "node src/styles/pwa/build-icons.mjs",
    "pwa-screenshots": "node src/styles/pwa/capture-screenshots.mjs",
    "typecheck": "node ../../node_modules/@typescript/native/bin/tsc --noEmit -p . --incremental --tsBuildInfoFile ../../.cache/gates/tsc/web.tsbuildinfo",
    "test": "vitest run",
    "lighthouse": "lighthouse",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o node_modules/.cache/storybook"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.7",
    "@pflanzendex/core": "*",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@tanstack/react-query": "5.108.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.74.0",
    "oidc-client-ts": "3.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-router": "8.5.1",
    "tailwind-merge": "3.7.0",
    "uqr": "0.1.3",
    "vaul": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.9",
    "@storybook/addon-docs": "10.6.9",
    "@storybook/addon-vitest": "10.6.9",
    "@storybook/react-vite": "10.6.9",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "jsdom": "31.0.1",
    "lighthouse": "13.6.0",
    "sharp": "0.35.5",
    "storybook": "10.6.9",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8"
  }
}
