{
  "name": "@pflanzendex/e2e",
  "private": true,
  "type": "module",
  "description": "End-to-end tests (QG-T3): Playwright against the real stack (Keycloak, PostgreSQL, API, Vite), mobile and desktop",
  "scripts": {
    "typecheck": "tsc --noEmit -p . --incremental --tsBuildInfoFile ../../.cache/gates/tsc/e2e.tsbuildinfo",
    "e2e": "playwright test --project=mobil --project=desktop",
    "one-screen": "E2E_WEB_BUILD=1 playwright test --project=one-screen --workers=${ONE_SCREEN_WORKERS:-4}",
    "one-screen:write": "ONE_SCREEN_WRITE=1 npm run one-screen",
    "a11y-routes": "E2E_WEB_BUILD=1 playwright test --project=a11y-routes --workers=${A11Y_ROUTES_WORKERS:-4}",
    "a11y-routes:write": "A11Y_ROUTES_WRITE=1 npm run a11y-routes",
    "a11y-routes:baseline": "tsx support/display/a11y/baseline-cli.ts",
    "ui-gates": "E2E_WEB_BUILD=1 playwright test --project=one-screen --project=a11y-routes --workers=${UI_GATES_WORKERS:-6}",
    "merge-shards": "node --import tsx tests/accessibility/routes/merge-shards.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "tsx": "4.23.15"
  }
}
