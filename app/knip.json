{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "@commitlint/cli",
    "lint-staged",
    "conventional-changelog-conventionalcommits"
  ],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs!", "scripts/storybook/*.mjs!", "modules.config.mjs!"],
      "ignore": ["scripts/coverage-config.d.mts", "modules.config.d.mts"]
    },
    "packages/db": {
      "project": ["src/**/*.ts!", "!src/**/fixtures.ts!", "!src/kernel/migrate-cli.ts!"]
    },
    "packages/core": {
      "project": ["src/**/*.ts!", "!src/**/*-test-helpers.ts!", "!src/**/*-stub.ts!"]
    },
    "packages/web": {
      "project": ["src/**/*.{ts,tsx,css}!", "!src/**/*-test-helpers.ts!"],
      "ignore": [".storybook/conformance-fixtures/**"]
    },
    "packages/e2e": {
      "project": ["**/*.ts"]
    }
  }
}
