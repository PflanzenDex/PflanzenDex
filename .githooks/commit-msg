#!/usr/bin/env sh
# QG-C1: Commit-Nachricht nach Conventional Commits (Regeln: app/commitlint.config.js).
. "$(dirname "$0")/_lib.sh"
need_setup
cd "$app" && npx --no-install commitlint --edit "$1" || {
  echo "Commit abgelehnt (QG-C1). Format: <typ>(<scope>): <Betreff>, z. B. feat(pha): Phase ableiten" >&2
  exit 1
}
