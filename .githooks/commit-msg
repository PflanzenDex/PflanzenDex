#!/usr/bin/env sh
# QG-C1: commit message follows Conventional Commits (rules: app/config/project/commitlint.config.js).
. "$(dirname "$0")/_lib.sh"
need_setup
cd "$app" && npx --no-install commitlint --config config/project/commitlint.config.js --edit "$1" || {
  echo "Commit rejected (QG-C1). Format: <type>(<scope>): <subject>, e.g. feat(pha): derive care phase" >&2
  exit 1
}
